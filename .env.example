# Vercel / app
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-local-random-secret"
# Optional for testing Next.js dev from an iPhone on the same LAN, e.g. "192.168.68.69"
NEXT_ALLOWED_DEV_ORIGINS=""

# Neon Postgres
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Google OAuth for Better Auth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Sentry error monitoring — optional locally; without a DSN the SDK is inert.
# NEXT_PUBLIC_SENTRY_DSN is public by design (it only allows sending events).
NEXT_PUBLIC_SENTRY_DSN=""
# Build-time only, for source-map upload. Never commit a real value.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
